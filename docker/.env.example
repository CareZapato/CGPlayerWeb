# Variables de entorno para Docker
# Copia este archivo como .env y modifica los valores según tu configuración

# === CONFIGURACIÓN DE BASE DE DATOS ===
DB_PASSWORD=cgplayer123
DATABASE_URL=postgresql://cgplayer:cgplayer123@database:5432/cgplayerweb

# === SEGURIDAD ===
# ⚠️ CAMBIAR EN PRODUCCIÓN - Generar con: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production-please

# === CONFIGURACIÓN DEL SERVIDOR ===
NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# === URLs Y CORS ===
FRONTEND_URL=http://localhost
BACKEND_URL=http://localhost:3001

# === REDIS (OPCIONAL) ===
REDIS_URL=redis://redis:6379

# === CONFIGURACIÓN DE ARCHIVOS ===
MAX_FILE_SIZE=50MB
UPLOAD_PATH=/app/backend/uploads

# === CONFIGURACIÓN INICIAL ===
# Poblar base de datos en primer inicio (true/false)
SEED_DATABASE=true

# === CONFIGURACIÓN DE RED ===
# IP del servidor para acceso externo (opcional)
# SERVER_IP=192.168.1.100

# === CONFIGURACIÓN DE EMAILS (FUTURO) ===
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-email@gmail.com
# SMTP_PASS=tu-password
