									"pm.test('Respuesta contiene estadísticas', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.stats).to.not.be.undefined;",
									"    pm.expect(jsonData.stats.totalUsers).to.be.above(300);",
