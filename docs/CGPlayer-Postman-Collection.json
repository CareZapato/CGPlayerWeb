									"    console.log('Mensaje:', jsonData.message);",
									"    ",
									"    if (jsonData.stats) {",
									"        console.log('\\n📊 ESTADÍSTICAS:');",
									"        console.log('- Total usuarios:', jsonData.stats.totalUsers);",
									"        console.log('- Usuarios activos:', jsonData.stats.activeUsers);",
									"        console.log('- Usuarios inactivos:', jsonData.stats.inactiveUsers);",
									"        console.log('- Ubicaciones:', jsonData.stats.locations);",
									"        ",
									"        console.log('\\n🏙️ DISTRIBUCIÓN POR CIUDAD:');",
									"        Object.entries(jsonData.stats.byCity).forEach(([city, count]) => {",
									"            console.log(`- ${city}: ${count} cantantes`);",
									"        });",
									"        ",
									"        console.log('\\n👥 USUARIOS ADMINISTRATIVOS:');",
									"        console.log('- Administradores:', jsonData.stats.administrativeUsers.admins);",
									"        console.log('- Directores:', jsonData.stats.administrativeUsers.directors);",
									"        console.log('- Cantantes de prueba:', jsonData.stats.administrativeUsers.testSingers);",
									"    }",
									"    ",
									"    console.log('\\nTimestamp:', jsonData.timestamp);",
									"} else {",
									"    console.log('❌ Error en el seed:', pm.response.text());",
									"}"
								],
								"type": "text/javascript"
							}
