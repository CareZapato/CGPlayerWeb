generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String             @id @default(cuid())
  email                 String             @unique
  username              String             @unique
  password              String
  firstName             String
  lastName              String
  profileImage          String?            // Nueva columna para imagen de perfil
  isActive              Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  locationId            String?
  phone                 String?
  eventAttendance       EventAttendance[]  @relation("EventAttendance")
  addedAttendees        EventAttendee[]    @relation("EventAttendeeAdder")
  eventAttendees        EventAttendee[]    @relation("EventAttendees")
  eventJoinRequests     EventJoinRequest[] @relation("EventJoinRequests")
  createdEvents         Event[]            @relation("EventCreator")
  lyricContributions    Lyric[]
  lyricsFileUploads     LyricsFile[]       @relation("LyricsFileUploader")
  playlists             Playlist[]
  soloPerformances      Soloist[]
  songAssignments       SongAssignment[]
  songUploads           Song[]             @relation("SongUploader")
  assignedRoles         UserRole_DB[]      @relation("RoleAssignments")
  roles                 UserRole_DB[]      @relation("UserRoles")
  assignedVoiceProfiles UserVoiceProfile[] @relation("VoiceAssignments")
  voiceProfiles         UserVoiceProfile[] @relation("UserVoiceProfiles")
  location              Location?          @relation(fields: [locationId], references: [id])

  @@map("users")
}

model UserRole_DB {
  id             String   @id @default(cuid())
  userId         String
  role           UserRole
  assignedBy     String?
  createdAt      DateTime @default(now())
  assignedByUser User?    @relation("RoleAssignments", fields: [assignedBy], references: [id])
  user           User     @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model UserVoiceProfile {
  id             String    @id @default(cuid())
  userId         String
  voiceType      VoiceType
  assignedBy     String?
  createdAt      DateTime  @default(now())
  assignedByUser User?     @relation("VoiceAssignments", fields: [assignedBy], references: [id])
  user           User      @relation("UserVoiceProfiles", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, voiceType])
  @@map("user_voice_profiles")
}

model Song {
  id            String           @id @default(cuid())
  title         String
  artist        String?
  album         String?
  duration      Int?
  fileName      String
  filePath      String
  fileSize      Int
  mimeType      String
  uploadedBy    String
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  genre         String?
  parentSongId  String?
  voiceType     VoiceType?
  coverColor    String?
  folderName    String?
  hasLyricSync  Boolean          @default(false)
  eventSongs    EventSong[]
  lyrics        Lyric[]
  lyricsFiles   LyricsFile[]
  playlistItems PlaylistItem[]
  soloists      Soloist[]
  assignments   SongAssignment[]
  parentSong    Song?            @relation("SongVersions", fields: [parentSongId], references: [id])
  childVersions Song[]           @relation("SongVersions")
  uploader      User             @relation("SongUploader", fields: [uploadedBy], references: [id])

  @@map("songs")
}

model LyricsFile {
  id         String         @id @default(cuid())
  songId     String
  fileName   String
  filePath   String
  fileSize   Int
  mimeType   String
  fileType   LyricsFileType
  uploadedBy String
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  song       Song           @relation(fields: [songId], references: [id], onDelete: Cascade)
  uploader   User           @relation("LyricsFileUploader", fields: [uploadedBy], references: [id])

  @@map("lyrics_files")
}

model SongAssignment {
  id        String    @id @default(cuid())
  songId    String
  userId    String
  voiceType VoiceType
  createdAt DateTime  @default(now())
  song      Song      @relation(fields: [songId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([songId, userId, voiceType])
  @@map("song_assignments")
}

model Playlist {
  id             String          @id @default(cuid())
  name           String
  description    String?
  userId         String
  voiceType      VoiceType?
  isPublic       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  imageUrl       String?
  eventPlaylists EventPlaylist[]
  items          PlaylistItem[]
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("playlists")
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  songId     String
  order      Int
  createdAt  DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([playlistId, order])
  @@map("playlist_items")
}

model Lyric {
  id             String     @id @default(cuid())
  songId         String
  content        String
  voiceType      VoiceType?
  createdBy      String
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  endTime        Float?
  lineNumber     Int
  startTime      Float?
  isTextLyrics   Boolean    @default(false)
  textContent    String?
  isSynchronized Boolean    @default(false)
  isHighlighted  Boolean    @default(true)
  creator        User       @relation(fields: [createdBy], references: [id])
  song           Song       @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([songId, lineNumber, voiceType])
  @@map("lyrics")
}

model Location {
  id        String       @id @default(cuid())
  name      String
  type      LocationType
  address   String?
  city      String
  region    String?
  country   String       @default("Chile")
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  color     String?
  phone     String?
  events    Event[]
  users     User[]

  @@map("locations")
}

model Event {
  id                String             @id @default(cuid())
  title             String
  description       String?
  date              DateTime
  time              String?
  category          String             @default("Culto")
  locationId        String?
  eventCity         String?
  eventAddress      String?
  country           String             @default("Chile")
  imageUrl          String?
  mapLink           String?
  isActive          Boolean            @default(true)
  isPublic          Boolean            @default(true)
  allowExternalJoin Boolean            @default(false)
  createdBy         String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  attendanceHistory EventAttendance[]
  attendees         EventAttendee[]
  joinRequests      EventJoinRequest[]
  eventPlaylists    EventPlaylist[]
  eventSongs        EventSong[]
  creator           User               @relation("EventCreator", fields: [createdBy], references: [id])
  location          Location?          @relation(fields: [locationId], references: [id])
  soloists          Soloist[]

  @@map("events")
}

model EventPlaylist {
  id         String   @id @default(cuid())
  eventId    String
  playlistId String
  order      Int?
  createdAt  DateTime @default(now())
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([eventId, playlistId])
  @@map("event_playlists")
}

model EventAttendee {
  id                    String              @id @default(cuid())
  eventId               String
  userId                String
  status                EventAttendeeStatus @default(PENDING)
  addedBy               String
  notes                 String?
  isExternal            Boolean             @default(false) // Indica si el asistente fue agregado por solicitud externa
  attendanceConfirmed   Boolean?            // null = no confirmado, true = confirma asistencia, false = confirma inasistencia
  nonAttendanceComment  String?             // Comentario de hasta 300 caracteres para inasistencia
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  addedByUser           User                @relation("EventAttendeeAdder", fields: [addedBy], references: [id])
  event                 Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user                  User                @relation("EventAttendees", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_attendees")
}

model EventJoinRequest {
  id        String                 @id @default(cuid())
  eventId   String
  userId    String
  status    EventJoinRequestStatus @default(PENDING)
  message   String?
  response  String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  event     Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User                   @relation("EventJoinRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_join_requests")
}

model EventAttendance {
  id          String    @id @default(cuid())
  eventId     String
  userId      String
  attended    Boolean   @default(false)
  checkedInAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User      @relation("EventAttendance", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_attendance")
}

model EventSong {
  id      String  @id @default(cuid())
  eventId String
  songId  String
  order   Int
  notes   String?
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  song    Song    @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([eventId, order])
  @@map("event_songs")
}

model Soloist {
  id          String      @id @default(cuid())
  eventId     String
  userId      String
  songId      String?
  soloistType SoloistType
  notes       String?
  createdAt   DateTime    @default(now())
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  song        Song?       @relation(fields: [songId], references: [id])
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("soloists")
}

enum EventAttendeeStatus {
  PENDING
  CONFIRMED
  CANCELLED
  NO_SHOW
}

enum EventJoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  ADMIN
  CANTANTE
  DIRECTOR
}

enum VoiceType {
  SOPRANO
  CONTRALTO
  TENOR
  BARITONO
  MESOSOPRANO
  BAJO
  CORO
  ORIGINAL
}

enum SoloistType {
  MALE
  FEMALE
  BOTH
}

enum LocationType {
  ANTOFAGASTA
  VINA_DEL_MAR
  SANTIAGO
  CONCEPCION
  VALDIVIA
  TODOS_LOS_CORISTAS
}

enum LyricsType {
  TEXT
  PDF
  DOC
  DOCX
}

model News {
  id          String    @id @default(cuid())
  title       String
  description String
  type        NewsType
  icon        String    // Icon name for the news type
  actionUrl   String?   // URL to navigate when clicking the news
  metadata    Json?     // Additional data like songId, eventId, etc.
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("news")
}

enum NewsType {
  SONG_ADDED
  EVENT_CREATED
  EVENT_UPDATED
  VERSION_RELEASED
}

enum LyricsFileType {
  PDF
  DOC
  DOCX
  IMAGE_JPG
  IMAGE_PNG
  TEXT
}
